<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.arif2fast.views.FileManagerController"
      stylesheets="@styles.css"
      spacing="20">
    <padding>
        <Insets bottom="25" left="25" right="25" top="25"/>
    </padding>

    <!-- Title -->
    <Label text="Liquibase CLI - SQL/YAML Upload Tool" styleClass="title"/>

    <!-- Upload Section Panel -->
    <VBox spacing="15" styleClass="panel, upload-section">
        <Label text="Upload File" styleClass="section-header"/>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Select File:" minWidth="60"/>
            <TextField fx:id="filePathTextField" editable="false" HBox.hgrow="ALWAYS" prefHeight="35"/>
            <Button fx:id="browseButton" text="Browse..." onAction="#handleBrowse" prefHeight="35"/>
        </HBox>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Module:" minWidth="60"/>
            <ComboBox fx:id="moduleComboBox" promptText="Select module" HBox.hgrow="ALWAYS" prefHeight="35" maxWidth="Infinity"/>
        </HBox>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Version:" minWidth="60"/>
            <ComboBox fx:id="versionComboBox" editable="true" promptText="Select or enter version" HBox.hgrow="ALWAYS" prefHeight="35" maxWidth="Infinity"/>
        </HBox>

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button fx:id="uploadButton" text="Upload File" onAction="#handleUpload" styleClass="primary-button" prefHeight="35" prefWidth="120"/>
        </HBox>
    </VBox>

    <!-- File List Section Panel -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="panel">
        <Label text="Uploaded Files" styleClass="section-header"/>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" prefHeight="35"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="deleteAllButton" text="Delete All" onAction="#handleAllDelete" styleClass="danger-button" prefHeight="35"/>
            <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDelete" styleClass="danger-button" prefHeight="35"/>
            <Button fx:id="executeUpdateButton" text="Execute Update" onAction="#handleExecuteUpdate" styleClass="primary-button" prefHeight="35"/>
        </HBox>

        <TreeView fx:id="fileTreeView" VBox.vgrow="ALWAYS" minHeight="250"/>
    </VBox>

    <!-- Status Section -->
    <HBox>
        <padding>
            <Insets top="-5"/>
        </padding>
        <Label fx:id="statusLabel" text="Ready" wrapText="true" styleClass="status-label"/>
    </HBox>

</VBox>
